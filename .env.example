# ============================================================
# 🔴 必改 — 安全凭据（所有 change_me 必须替换）
# ============================================================
# 随机密码生成: openssl rand -hex 16（末尾数字可改，对应密码长度）

# MySQL root 密码（仅供 mysql 容器初始化）
DB_ROOT_PASSWORD=change_me

# MySQL 应用库密码（php + task-daemon 连接用）
DB_PASSWORD=change_me

# 内部 API 认证令牌（sidecar + task-daemon 每日更新认证）
SIDECAR_TOKEN=change_me

# 腾讯云 API 密钥（SES 邮件服务，建议用子账户仅授必要权限）
# 获取: https://console.cloud.tencent.com/cam/capi
SES_SECRET_ID=change_me
SES_SECRET_KEY=change_me

# ============================================================
# 🟡 必改 — 环境适配（按实际路径和 uid/gid 修改）
# ============================================================
# 游戏文件目录（steamcmd 下载目标，bind mount 进 l4d2 容器；相对 compose 文件所在目录）
GAME_DIR=./l4d2/src

# 容器运行用户（必须与 GAME_DIR 所有者 一致，否则 SourceMod Permission denied）
# 查看目录所有者: ls -ld <GAME_DIR>；查看 uid/gid: id -u <user>; id -g <user>
APP_UID=1002
APP_GID=1002

# ============================================================
# 🟢 可选 — MySQL
# ============================================================
DB_DATABASE=steam
DB_USER=steam

# ============================================================
# 🟢 可选 — Web 站点品牌
# ============================================================
# 以下变量注入 php 容器（见 docker-compose.yml），config.php 无内置默认值，缺省则对应字段为空。

# 站点品牌（注册/验证邮件、导航栏、邮件发件人）
BRAND_EMAIL=admin@example.com
BRAND_DOMAIN=tunarund.top
BRAND_REPLY_EMAIL=reply@example.com
BRAND_COMPANY=Tunarund GameLife
BRAND_SITE=TunArund

# Steam 群组 slug（「加入群组」按钮链接 /steamcommunity.com/groups/<slug>）
BRAND_STEAM_GROUP=example-group

# 页脚备案：BRAND_ICP 为显示文本；BRAND_PSB 为纯数字编码（拼链接 + 显示）
BRAND_ICP=ICP备案号
BRAND_PSB=公安备案号

# 出站 HTTP 代理（php 服务 curl_proxy() 访问外部 API 时使用；留空 = 直连）
HTTP_PROXY=http://127.0.0.1:7890

# ============================================================
# 🟢 可选 — L4D2 游戏服务器
# ============================================================
# 游戏服公网 IP（仅 IP，不含端口；端口由下方 L4D2_PORT 决定，用于「一键连接」/「IP 直连」）
# steam://connect 仅支持 IP 不支持域名；查询本机公网 IP: curl -4 ifconfig.me  或  curl -4 ip.sb
SERVER_IP=1.2.3.4

# 对外端口（默认 27015 / 27014，冲突时修改）
L4D2_PORT=27015
L4D2_VERSUS_PORT=27014

# srcds 启动参数（默认值如下，覆盖时直接修改）
L4D2_COOP_ARGS=+ip 0.0.0.0 -port 27015 -timeout 2 +sv_steam_bypass 1 +sv_setmax 32 +map c2m1_highway +z_difficulty normal +exec server.cfg -tickrate 100 -high -heapsize 524288 -num_edicts 4096 -processheap
L4D2_VERSUS_ARGS=+ip 0.0.0.0 -port 27015 +sv_clockcorrection_msecs 25 -timeout 2 -tickrate 100 +mp_gamemode versus +map c1m1_hotel -maxplayers 32 +exec server.cfg

# ============================================================
# 🟢 可选 — 腾讯云 COS（地图 CDN 分发）
# ============================================================
# 留空则跳过 COS 上传，地图仅能通过 Steam CDN 下载
# 获取: https://console.cloud.tencent.com/cos/bucket → 存储桶列表 → 配置管理
# SecretId/SecretKey 同 CAM API 密钥，也可单独创建子账号
COS_SECRET_ID=change_me
COS_SECRET_KEY=change_me
COS_BUCKET=your-bucket-id
COS_REGION=ap-guangzhou

# CDN 自定义域名（可选）
COS_CUSTOM_DOMAIN=http://cdn.example.com

# 内部请求协议 http/https（默认 https）
COS_SCHEME=https

# ============================================================
# 🟢 可选 — sidecar 可控制哪些容器启停
# ============================================================
ALLOWED_CONTAINERS=l4d2-task-daemon,l4d2-coop,l4d2-versus,l4d2-php,l4d2-mysql,l4d2-glances,l4d2-nginx
RESTARTABLE_CONTAINERS=l4d2-task-daemon,l4d2-coop,l4d2-versus

# ============================================================
# 🟢 可选 — 任务守护进程 (task-daemon) & 日志
# ============================================================
# 地图下载目录（task-daemon 下载 vpk 的目标路径）
MAP_DIR=/var/www/addons/workshop/

# 日志目录（PHP 错误日志 + task-daemon 守护进程日志）
LOG_DIR=/var/www/html/logs/

# ============================================================
# 🟢 可选 — 镜像构建 & CI/CD
# ============================================================
# 镜像仓库前缀（开发留空，推送 GitHub 时设 ghcr.io/<user>/）
REGISTRY=

# 容器时区（构建时烘焙进镜像，运行时不变）
TZ=Asia/Shanghai

# Alpine 包镜像源（国内用 mirrors.aliyun.com，海外留空走官方源）
APK_MIRROR=mirrors.aliyun.com

# GitHub 凭据（仅 docker.sh push 时需要）
# Settings → Developer settings → Personal access tokens → Classic，勾选 write:packages, delete:packages
GITHUB_USER=change_me
GITHUB_TOKEN=change_me
